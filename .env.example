# =============================================================================
# Smart Crop Bot — Environment Variables
# Copy this file to .env and fill in values. Never commit .env.
# =============================================================================

# --- Telegram Bot API ---
# Create a bot via @BotFather on Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=
# Optional: bot @username without @ (landing page t.me link). Auto-resolved via getMe if empty.
# TELEGRAM_BOT_USERNAME=YourBotUsername
# Optional: random string for webhook verification (set same value when registering webhook)
# TELEGRAM_WEBHOOK_SECRET=

# --- App ---
APP_ENV=development
# Public HTTPS URL (tunnel or deploy URL) — required for Telegram webhook registration
#   npx --yes cloudflared tunnel --url http://127.0.0.1:8000
# Or double-click START_DEMO.bat
APP_PUBLIC_URL=https://YOUR_TUNNEL.trycloudflare.com

LOG_LEVEL=INFO

# --- Phase 2 AI ---
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model overrides (defaults updated for 2026 deprecations):
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Gemini 3.6 uses hidden "thinking" tokens — keep chat budget high (default 4096)
# CHAT_MAX_OUTPUT_TOKENS=4096
# DIAGNOSIS_MAX_OUTPUT_TOKENS=2048

# --- Phase 3 voice (optional overrides) ---
# TTS_ENABLED=true
# TTS_ON_DIAGNOSIS=true
# TTS_VOICE=hi-IN-SwaraNeural

# --- Phase 4 ---
OPENWEATHER_API_KEY=
# DATABASE_PATH=c:\Krishi\data\smart_crop_bot.db
# MEDIA_DIR=c:\Krishi\media
# Optional Postgres (Supabase/Neon). Empty = SQLite at DATABASE_PATH for mandi cache too.
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres

# Agmarknet daily prices (https://data.gov.in) — never commit the real key
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Optional: digits only for the landing wa.me WhatsApp card (UI only — no WhatsApp backend)
# WHATSAPP_DISPLAY_NUMBER=91XXXXXXXXXX

# --- Proactive Agricultural Nudge Loop ---
# Rain rule: any 3h forecast point in next LOOKAHEAD hours with
#   pop >= PROACTIVE_RAIN_POP_THRESHOLD
#   OR rain_mm >= PROACTIVE_RAIN_MM_THRESHOLD
#   OR weather label Rain/Drizzle/Thunderstorm
# AND farmer has at least one OPEN advisory.
PROACTIVE_ENABLED=true
PROACTIVE_CHECK_INTERVAL_MINUTES=15
PROACTIVE_LOOKAHEAD_HOURS=24
PROACTIVE_RAIN_POP_THRESHOLD=0.40
PROACTIVE_RAIN_MM_THRESHOLD=1.0
PROACTIVE_NUDGE_COOLDOWN_HOURS=24
PROACTIVE_DEMO_MODE=false

# --- Phase 5 (production / Render) ---
# APP_ENV=production
# APP_PUBLIC_URL=https://YOUR-SERVICE.onrender.com
# SQLite lives in /app/data (not /tmp). Render Free still wipes disk on sleep;
# the bot re-asks for a location pin on /start or whenever none is saved.
# DATABASE_PATH=/app/data/smart_crop_bot.db
# MEDIA_DIR=/tmp/scb_media
